{
  // Local dev only. Deploys go through Freebuff Sites (manifest.json); it injects auth vars and DB.
  "name": "vibe-catalog",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "FREEBUFF_CLIENT_ID": "6d6558ea-07f3-45ba-a302-e1aee6d9e888",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "vibe-catalog", "database_id": "local" }]
}
