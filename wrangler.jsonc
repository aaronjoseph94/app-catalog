{
  "name": "app-catalog",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "apps.aaronjoseph.ca", "custom_domain": true }],
  // ADMIN_PASSWORD is a secret: `wrangler secret put ADMIN_PASSWORD` (local: .dev.vars)
  "d1_databases": [{ "binding": "DB", "database_name": "app-catalog", "database_id": "a8184889-54bd-4401-9430-ddee085ca006" }]
}
